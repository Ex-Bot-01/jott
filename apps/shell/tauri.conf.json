{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jott",
  "version": "0.0.0",
  "identifier": "dev.jott.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jott",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
