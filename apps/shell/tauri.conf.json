{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jott",
  "version": "0.0.3",
  "identifier": "dev.jott.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jott",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "backgroundColor": [250, 250, 249, 255]
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "np/np*": "np/" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
